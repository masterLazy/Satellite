{
	"schemaVersion": 1,
	"id": "satellite",
	"version": "${version}",
	"name": "Satellite",
	"description": "Powerful server management toolkit",
	"authors": [
		"masterLazy"
	],
	"contact": {
		"homepage": "https://github.com/masterLazy/Satellite",
		"sources": "https://github.com/masterLazy/Satellite",
		"issues": "https://github.com/masterLazy/Satellite/issues"
	},
	"license": "Apache License 2.0",
	"icon": "assets/satellite/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [ "masterlazy.satellite.Satellite" ],
		"server": [ "masterlazy.satellite.SatelliteServer" ],
		"client": [ "masterlazy.satellite.client.SatelliteClient" ]
	},
	"mixins": [
		"satellite.mixins.json",
		{
			"config": "satellite.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_compatible_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}